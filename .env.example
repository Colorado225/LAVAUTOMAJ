# WashPilot CI — Frontend Vite — variables d'environnement
# Copier vers .env et remplir la clé publique Clerk avant `npm run dev:web`.
# IMPORTANT : le frontend tourne sur :5173 (vite.config.ts) et proxie /api,
# /healthz, /readyz vers le backend Go sur :3000.

# Clé publique Clerk (Dashboard Clerk > API Keys > Publishable key).
# Sans elle, App.tsx affiche "Configuration Clerk requise" et useSignIn/useSignUp
# restent isLoaded=false : les boutons restent désactivés.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Laisser vide en dev local : apiFetch utilise le proxy Vite vers :3000.
# En production, mettre l'URL publique du backend Go (ex. https://api.washpilot.ci).
VITE_API_BASE_URL=

# --- Backend Go (voir backend/.env.example pour le détail) ---
# Copier backend/.env.example vers backend/.env avant `go run ./cmd/api`.
# Le backend écoute sur PORT (3000 = attendu par le proxy Vite).
# Variables clés : PORT, DATABASE_URL, CLERK_SECRET_KEY, CORS_ORIGINS=http://localhost:5173
