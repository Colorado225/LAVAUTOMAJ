# ---------------------------------------------------------------------------
# WashPilot CI — variables d'environnement
# Copiez ce fichier en `.env` puis complétez les valeurs. Ne committez JAMAIS
# le fichier `.env` (il est ignoré par Git).
# ---------------------------------------------------------------------------

# --- Serveur ----------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Base de données (Neon / PostgreSQL) -------------------------------------
# Obligatoire en production. En développement, le serveur démarre sans base
# mais les routes API répondent 503 tant qu'elle n'est pas configurée.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
PG_POOL_MAX=10

# --- Authentification ---------------------------------------------------------
# L'authentification (e-mail + mot de passe) est gérée directement dans la base
# PostgreSQL/Neon : aucune clé externe n'est nécessaire. Les sessions sont des
# cookies httpOnly signés côté serveur et stockées dans la table auth_sessions.

# --- CORS ---------------------------------------------------------------------
# Origines frontend autorisées, séparées par des virgules.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

NEON_DATABASE_URL= postgresql://neondb_owner:npg_a7c3oWPuEhyr@ep-small-dream-b9lkx0i0-pooler.c-7.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# S3-compatible storage. Generate a credential to fill in the key ID + secret.
AWS_ENDPOINT_URL_S3="https://br-green-voice-b9ikzx9x.storage.c-7.eu-central-1.aws.neon.tech"
AWS_ACCESS_KEY_ID="nak_live_b11412406f7145df80ec88c1bff18a7f"
AWS_SECRET_ACCESS_KEY="••••••••••••••••••••••••••••••••"
AWS_REGION="eu-central-1"