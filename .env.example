# ---------------------------------------------------------------------------
# WashPilot CI — variables d'environnement
# Copiez ce fichier en `.env` puis complétez les valeurs. Ne committez JAMAIS
# le fichier `.env` (il est ignoré par Git).
# ---------------------------------------------------------------------------

# --- Serveur ----------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Base de données (Neon / PostgreSQL) -------------------------------------
# Obligatoire en production. En développement, le serveur démarre sans base
# mais les routes API répondent 503 tant qu'elle n'est pas configurée.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
PG_POOL_MAX=10

# --- Clerk (authentification) -------------------------------------------------
# Clé publique exposée au frontend (Vite).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx
# Clé secrète serveur — obligatoire en production.
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# Optionnel : clé publique JWT (vérification réseau-less des tokens).
CLERK_JWT_KEY=
# Optionnel : origines autorisées dans le claim azp du token (séparées par des virgules).
CLERK_AUTHORIZED_PARTIES=
# Secret de signature du webhook Clerk (svix) — requis pour /api/webhooks/clerk.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxx

# --- CORS ---------------------------------------------------------------------
# Origines frontend autorisées, séparées par des virgules.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
