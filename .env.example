AWS_ACCESS_KEY_ID=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_SECRET_ACCESS_KEY=
CORS_ORIGINS=
DATABASE_URL=
NEON_DATABASE_URL=
PG_POOL_MAX=

# URL publique de l'application (liens envoyés par e-mail, ex. https://app.washpilot.ci)
APP_URL=
# Durée de validité d'un lien de réinitialisation de mot de passe, en minutes (défaut 60)
PASSWORD_RESET_TTL_MINUTES=
# Envoi des e-mails transactionnels via Resend. Sans clé, les liens sont journalisés
# côté serveur (et renvoyés dans la réponse API hors production uniquement).
RESEND_API_KEY=
MAIL_FROM=

# --- Assistance ---------------------------------------------------------
# Numéro WhatsApp affiché dans le bouton d'aide, au format international.
# Laissé vide hors production, un numéro de démonstration est affiché.
SUPPORT_WHATSAPP=
# Adresse e-mail de l'assistance (recours secondaire et destinataire des
# demandes d'activation de forfait).
SUPPORT_EMAIL=

# --- Relances d'échéance d'abonnement -----------------------------------
# Relances automatiques J-3, J-1 et à l'expiration de l'essai (true par défaut).
REMINDERS_ENABLED=
# Intervalle du planificateur, en minutes (5 à 1440, défaut 60).
REMINDERS_INTERVAL_MINUTES=

# --- Sauvegarde ---------------------------------------------------------
# Dossier de destination de scripts/db-backup.sh (défaut ./backups)
BACKUP_DIR=
# Nombre de jours de conservation des sauvegardes locales (défaut 30)
RETENTION_DAYS=
