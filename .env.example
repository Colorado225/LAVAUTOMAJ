# Clerk (seule la clé publique est exposée au frontend)
# Nom canonique pour Vite :
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Alias public accepté pour compatibilité avec les projets Next.js :
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Facultatif : clé PEM publique Clerk pour vérifier les JWT sans charger les JWKS.
CLERK_JWT_KEY=
# Origines frontend autorisées pour les JWT Clerk, séparées par des virgules.
CLERK_AUTHORIZED_PARTIES=
# Signing secret du webhook Clerk (user.created/updated/deleted, organisation/membership).
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# PostgreSQL / Neon (utiliser l'URL pooled Neon avec sslmode=require en production)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
PG_POOL_MAX=10

# Application
PORT=3000
NODE_ENV=development
# À définir seulement si l'API est appelée depuis un autre domaine.
CORS_ORIGINS=http://localhost:3000
# Vite utilise la même origine par défaut; laisser vide dans la majorité des déploiements.
VITE_API_BASE_URL=
