# WashPilot CI — Backend Go — variables d'environnement
# Copier vers .env et remplir les valeurs réelles avant le premier démarrage.

# Application
PORT=3000
NODE_ENV=development

# PostgreSQL / Neon (URL pooled avec sslmode=require en production)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
PG_POOL_MAX=10

# Clerk (seule la clé publique est exposée au frontend)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Facultatif : clé PEM publique Clerk pour vérifier les JWT sans charger les JWKS.
CLERK_JWT_KEY=
# Origines autorisées pour les JWT Clerk (azp claim), séparées par des virgules.
CLERK_AUTHORIZED_PARTIES=
# Signing secret du webhook Clerk (user.created/updated/deleted, organisation/membership).
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# CORS (origines frontend autorisées, séparées par des virgules)
# Le frontend Vite tourne sur http://localhost:5173 (voir vite.config.ts).
CORS_ORIGINS=http://localhost:5173
